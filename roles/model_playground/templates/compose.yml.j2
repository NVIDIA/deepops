# Generated by the opt-in model_playground role. Contains paths, never credentials.
services:
  vllm:
    image: {{ playground_vllm_image | to_json }}
    user: "0:0"
    restart: unless-stopped
    runtime: nvidia
    deploy:
      resources:
        reservations:
          devices:
            - driver: nvidia
              count: 1
              capabilities: [gpu]
    shm_size: 2gb
    networks: [private]
    security_opt: [no-new-privileges:true]
    cap_drop: [ALL]
    logging:
      driver: none
    environment:
      HF_HUB_OFFLINE: "1"
      HF_HUB_DISABLE_TELEMETRY: "1"
      HF_HUB_DISABLE_IMPLICIT_TOKEN: "1"
      HF_HUB_CACHE: /models
      VLLM_NO_USAGE_STATS: "1"
      DO_NOT_TRACK: "1"
    volumes:
      - /var/lib/deepops/model-playground/cache:/models:ro
      - /var/lib/deepops/model-playground/bin:/opt/playground:ro
      - /var/lib/deepops/model-playground/secrets/api-key:/run/playground/api-key:ro
    entrypoint: [python3, /opt/playground/playground_entrypoint.py, vllm]
    command:
      - --model
      - {{ ('/models/models--' ~ playground_model.repo | replace('/', '--') ~ '/snapshots/' ~ playground_model.revision) | to_json }}
      - --served-model-name
      - {{ playground_model.served_name | to_json }}
      - --host
      - "0.0.0.0"
      - --port
      - "8000"
      - --tensor-parallel-size
      - "1"
      - --max-model-len
      - "8192"
      - --max-num-seqs
      - "4"
      - --gpu-memory-utilization
      - "0.85"
      - --disable-log-requests
  webui:
    image: {{ playground_webui_image | to_json }}
    user: "0:0"
    restart: unless-stopped
    networks: [private]
    security_opt: [no-new-privileges:true]
    cap_drop: [ALL]
    logging:
      driver: none
    volumes:
      - /var/lib/deepops/model-playground/webui-data:/app/backend/data
      - /var/lib/deepops/model-playground/bin:/opt/playground:ro
      - /var/lib/deepops/model-playground/secrets:/run/playground:ro
    entrypoint: [python3, /opt/playground/playground_entrypoint.py, webui]
    environment:
      WEBUI_AUTH: "true"
      ENABLE_SIGNUP: "false"
      ENABLE_LOGIN_FORM: "true"
      DEFAULT_USER_ROLE: pending
      ENABLE_PERSISTENT_CONFIG: "false"
      ENABLE_OLLAMA_API: "false"
      ENABLE_OPENAI_API: "true"
      OPENAI_API_BASE_URLS: http://vllm:8000/v1
      ENABLE_DIRECT_CONNECTIONS: "false"
      ENABLE_DIRECT_INTEGRATIONS: "false"
      ENABLE_WEB_SEARCH: "false"
      ENABLE_IMAGE_GENERATION: "false"
      ENABLE_IMAGE_EDIT: "false"
      ENABLE_IMAGE_PROMPT_GENERATION: "false"
      ENABLE_COMMUNITY_SHARING: "false"
      ENABLE_EVALUATION_ARENA_MODELS: "false"
      ENABLE_CODE_EXECUTION: "false"
      ENABLE_CODE_INTERPRETER: "false"
      ENABLE_API_KEYS: "false"
      ENABLE_VERSION_UPDATE_CHECK: "false"
      ENABLE_OPENAI_API_CACHE: "false"
      USER_PERMISSIONS_CHAT_SHARE: "false"
      USER_PERMISSIONS_CHAT_ALLOW_PUBLIC_SHARING: "false"
      USER_PERMISSIONS_CHAT_ALLOW_OPEN_SHARING: "false"
      USER_PERMISSIONS_CHAT_FILE_UPLOAD: "false"
      USER_PERMISSIONS_CHAT_WEB_UPLOAD: "false"
      USER_PERMISSIONS_CHAT_STT: "false"
      USER_PERMISSIONS_CHAT_TTS: "false"
      USER_PERMISSIONS_CHAT_CALL: "false"
      USER_PERMISSIONS_FEATURES_DIRECT_TOOL_SERVERS: "false"
      OFFLINE_MODE: "true"
      HF_HUB_OFFLINE: "1"
      HF_HUB_DISABLE_TELEMETRY: "1"
      RAG_EMBEDDING_MODEL_AUTO_UPDATE: "false"
      RAG_RERANKING_MODEL_AUTO_UPDATE: "false"
      WHISPER_MODEL_AUTO_UPDATE: "false"
      DO_NOT_TRACK: "true"
      SCARF_NO_ANALYTICS: "true"
      ANONYMIZED_TELEMETRY: "false"
      WEBUI_SESSION_COOKIE_SECURE: "true"
      WEBUI_AUTH_COOKIE_SECURE: "true"
      WEBUI_SESSION_COOKIE_SAME_SITE: strict
      CORS_ALLOW_ORIGIN: {{ ('https://' ~ playground_tls_name ~ ':' ~ playground_https_port) | to_json }}
  gateway:
    image: {{ playground_nginx_image | to_json }}
    restart: unless-stopped
    networks: [private, frontend]
    ports:
      - {{ (playground_bind_address ~ ':' ~ playground_https_port ~ ':443') | to_json }}
    volumes:
      - /var/lib/deepops/model-playground/nginx.conf:/etc/nginx/nginx.conf:ro
      - /var/lib/deepops/model-playground/tls:/etc/playground-tls:ro
    security_opt: [no-new-privileges:true]
    logging:
      driver: none
networks:
  private:
    internal: true
  frontend: {}
